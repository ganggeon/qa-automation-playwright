{
  "info": {
    "_postman_id": "5d0f9430-453d-4f21-b700-37ff64e40867",
    "name": "MiniShop",
    "description": "MiniShop(로컬 SUT) 주문 흐름 검증용 컬렉션. 로그인 → 장바구니 담기 → 주문까지의 정상 경로와, 토큰 없이 장바구니에 담는 401 케이스로 구성했습니다. 요청 4건 · 단언 9건. 로그인 응답의 토큰을 환경변수로 받아 다음 요청에 전달합니다. 실행 전 SUT를 기동하고(http://localhost:4010) 새로 기동한 직후 상태를 전제로 합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "로그인",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();\r",
              "pm.environment.set(\"token\", body.token);\r",
              "\r",
              "pm.test(\"상태코드가 200이다\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"토큰이 문자열로 내려온다\", function () {\r",
              "    pm.expect(pm.response.json().token).to.be.a(\"string\").and.not.empty;\r",
              "});\r",
              "\r",
              "pm.test(\"응답에 password가 들어있지 않다\", function () {\r",
              "    pm.expect(pm.response.text()).to.not.include(\"password\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"qa@test.com\",\"password\":\"Qa123456\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "장바구니 담기",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"상태코드가 201이다\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"담은 수량이 요청과 같다\", function () {\r",
              "    pm.expect(pm.response.json().totalQty).to.eql(2);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":1,\"qty\":2}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      },
      "response": []
    },
    {
      "name": "장바구니 담기 - 토큰 없음 (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"토큰 없이 담기는 401이다\", function () {\r",
              "    pm.response.to.have.status(401);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"productId\":1,\"qty\":2}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/cart",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cart"
          ]
        }
      },
      "response": []
    },
    {
      "name": "주문",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"상태코드가 201이다\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"finalPrice = totalPrice - discount\", function () {\r",
              "    const b = pm.response.json();\r",
              "    pm.expect(b.finalPrice).to.eql(b.totalPrice - b.discount);\r",
              "});\r",
              "\r",
              "pm.test(\"금액이 음수가 아니다\", function () {\r",
              "    pm.expect(pm.response.json().finalPrice).to.be.at.least(0);\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\"couponCode\":\"WELCOME10\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      },
      "response": []
    }
  ]
}